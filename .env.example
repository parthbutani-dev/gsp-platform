MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/gsp?retryWrites=true&w=majority&appName=gsp-cluster
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES=8h
FRONTEND_URL=http://localhost:4200
PORT=3000
COOKIE_SECURE=false
ALLOW_HEADER_AUTH=true
ENABLE_SEED=true
NODE_ENV=development
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=30000
