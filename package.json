{
  "name": "gsp-platform",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "build:shared": "npm run build -w @gsp/shared",
    "dev:backend": "npm run build:shared && npm run dev -w @gsp/backend",
    "dev:frontend": "npm run start -w @gsp/frontend",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "seed": "npm run seed -w @gsp/backend",
    "test": "npm run test -w @gsp/backend",
    "format": "prettier --write \"**/*.{ts,json,md,css,html,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,css,html,mjs}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.22.0"
  }
}
